generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  profile      Profile?
  transactions Transaction[]
  financialData FinancialData[]
}

model Profile {
  id            String        @id @default(cuid())
  userId        String        @unique
  displayName   String
  bio           String?
  avatarUrl     String?
  tags          String[]
  model3d       Asset3DMetadata
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

type Asset3DMetadata {
  assetId       String
  assetName     String
  format        String
  sourceUrl     String
  thumbnailUrl  String?
  fileSizeBytes Int
  polyCount     Int
  textureCount  Int?
  rigged        Boolean
  animations    String[]
  uploadedAt    DateTime
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Float
  currency    String
  status      String
  hash        String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinancialData {
  id              String   @id @default(cuid())
  userId          String
  accountNumber   String?
  accountType     String
  institutionName String
  balance         Decimal  @db.Decimal(20, 4)
  currency        String   @default("USD")
  dataSource      String
  isEncrypted     Boolean  @default(false)
  encryptionKeyId String?
  metadata        Json?
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([institutionName])
}
