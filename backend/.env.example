# Arcana Backend - Environment Variables
# Copy this file to .env and fill in your actual values

# Server configuration
PORT=3001
NODE_ENV=development

# Database configuration
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/arcana_db?schema=public"

# JWT Configuration - CRITICAL: Change these in production!
JWT_SECRET="change-this-to-a-long-random-secret-string-at-least-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
